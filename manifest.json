{
  "manifest_version": 3,
  "name": "BakungKron",
  "version": "1.0.0",
  "description": "Beautiful modern new tab page with bookmarks grid, history, shortcuts, and search engine selector",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "bookmarks",
    "history",
    "storage"
  ],
  "host_permissions": [
    "https://suggestqueries.google.com/*",
    "https://api.bing.com/*",
    "https://duckduckgo.com/*",
    "https://en.wikipedia.org/*",
    "https://completion.amazon.com/*",
    "https://www.google.com/*",
    "https://www.favicons.co/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
